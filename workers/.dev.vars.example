# Copy to .dev.vars (gitignored) for `wrangler dev`. Do not put real credentials in git.
#
# Leave SUPABASE_* empty to run collectors without writing to Postgres.
# Placeholder hosts (YOUR_PROJECT.supabase.co) are ignored on purpose: workerd
# throws an uncatchable error if DNS lookup fails.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_TRIGGER_SECRET=dev-only-trigger-secret

# BE-3 Smiles. Dry-run uses bundled PET→CGH JSON (no live login).
# For live guest search, copy x-api-key from DevTools on
# api-air-flightsearch-blue.smiles.com.br/v1/airlines/search.
SMILES_DRY_RUN=1
SMILES_API_KEY=
# SMILES_COOKIE=
# SMILES_MEMBER_NUMBER=
# SMILES_USER=
# SMILES_PASS=
# SMILES_REQUEST_DELAY_MS=400

# BE-4 TudoAzul / Azul. Frozen secrets (placeholders only).
# Dry-run uses bundled PET→VCP and PET→POA JSON (no live login).
TUDOAZUL_DRY_RUN=1
TUDOAZUL_LOGIN=
TUDOAZUL_PASSWORD=
# TUDOAZUL_API_HOST=https://b2c-api.voeazul.com.br
# TUDOAZUL_REQUEST_DELAY_MS=400

# BE-5 LATAM Pass / LATAM. Frozen secrets (placeholders only).
# Dry-run uses bundled PET→GRU JSON (no live login).
LATAM_DRY_RUN=1
LATAM_LOGIN=
LATAM_PASSWORD=
# LATAM_COOKIE=
# LATAM_API_HOST=https://www.latamairlines.com
# LATAM_REQUEST_DELAY_MS=400
