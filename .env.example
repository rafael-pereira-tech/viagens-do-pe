# Base URL of the Workers read API (BE-6). Empty = local UI stubs.
# Example: https://viagens-do-pe-ingest.<account>.workers.dev
VITE_API_URL=

# Optional. Only if the Worker has API_READ_SECRET set.
# This value is bundled into the browser — never put SUPABASE_SERVICE_ROLE_KEY here.
VITE_API_TOKEN=
