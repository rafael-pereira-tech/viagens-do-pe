# Base URL of the Workers read API (BE-6). Empty = local UI stubs.
# Example: https://viagens-do-pe-ingest.<account>.workers.dev
VITE_API_URL=

# Must match Worker READ_API_KEY. Sent as Authorization: Bearer …
# Bundled into the Pages build (public config) — never a Supabase key.
VITE_READ_API_KEY=
