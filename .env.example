# Base URL of the Workers read API (BE-6). Empty = local UI stubs (placeholders).
# Cloudflare Pages must set this at build time, then redeploy.
VITE_API_URL=https://viagens-do-pe-ingest.rafaellimapereira.workers.dev

# Worker is live WITH Bearer. Pages needs BOTH VITE_API_URL and VITE_API_TOKEN
# when the Worker has API_READ_SECRET / READ_API_KEY (same value).
# Sent as Authorization: Bearer … — never a Supabase key.
# Alias: VITE_READ_API_KEY. Do not add VITE_SUPABASE* ; Security greps the bundle.
VITE_API_TOKEN=
VITE_READ_API_KEY=
