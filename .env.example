# Base URL of the Workers read API (BE-6). Empty = local UI stubs (placeholders).
# Cloudflare Pages must set this at build time, then redeploy.
VITE_API_URL=https://viagens-do-pe-ingest.rafaellimapereira.workers.dev

# Optional. Only if the Worker has API_READ_SECRET set.
# This value is bundled into the browser — never put SUPABASE_SERVICE_ROLE_KEY here.
# Do not add VITE_SUPABASE* variables; Security greps the bundle.
VITE_API_TOKEN=
